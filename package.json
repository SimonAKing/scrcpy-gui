{
  "name": "scrcpy-gui",
  "version": "2.0.0-beta.1",
  "description": "A modern, secure desktop GUI for scrcpy",
  "author": "Simon Ma <simon@tomotoes.com>",
  "homepage": "https://github.com/SimonAKing/scrcpy-gui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SimonAKing/scrcpy-gui.git"
  },
  "bugs": "https://github.com/SimonAKing/scrcpy-gui/issues",
  "desktopName": "scrcpy-gui.desktop",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && electron-vite build",
    "build:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "build": {
    "appId": "com.simonaking.scrcpygui",
    "productName": "Scrcpy GUI",
    "copyright": "Copyright © 2019-2026 Simon Ma and contributors",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons/16x16.png",
        "to": "icons/tray.png"
      }
    ],
    "asar": true,
    "mac": {
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icons",
      "category": "Utility",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
